#
# This file is typically only necessary on init.d based operating
# systems and is commonly installed as /etc/default/weewx
#
# This file is 'not' used on systemd-based operating systems
#
# Weewx needs to be restarted for these settings to take effect.
#

# WeeWX parameters that are used in startup and init scripts
WEEWX_PYTHON=python3
WEEWX_PYTHON_ARGS=
WEEWX_BINDIR=/usr/share/weewx
WEEWX_CFGDIR=/etc/weewx
WEEWX_RUNDIR=/var/lib/weewx
WEEWX_USER=weewx
WEEWX_GROUP=weewx
WEEWX_INSTANCES="weewx"
WEEWX_CFG=weewx.conf
