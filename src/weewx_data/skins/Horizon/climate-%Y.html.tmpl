#errorCatcher Echo
#encoding UTF-8
##
## The climate page of one year, with the panels from climate.inc. WeeWX writes the
## page on every report cycle while its year is running, and a last time when the
## year has ended. Where '$page' is 'climate_year', the includes therefore leave
## out what would go stale: the time of update, the station's particulars in the
## footer, the live update and the year picker.
#set global $climate_year = $year.dateTime.format("%Y")
#set global $page_title = '{0} {1}'.format($gettext("Climate"), $climate_year)
#set global $page_units = True
<!DOCTYPE html>
<html lang="$lang">
  <head>
    #include "head.inc"
  </head>
  <body>
    <div class="page">
      #include "masthead.inc"
      #include "nav.inc"
      <main class="board" id="content">
        #include "climate.inc"
      </main>
      #include "footer.inc"
    </div>
    #include "scripts.inc"
  </body>
</html>
