#errorCatcher Echo
#encoding UTF-8

#set $timespans = ['day', 'week', 'month', 'year', 'rainyear']
#set $observations = $to_list($DisplayOptions.get('observations_stats', ['outTemp']))
#set $obs_type_sum = $to_list($DisplayOptions.get('obs_type_sum', ['rain']))
#set $obs_type_max = $to_list($DisplayOptions.get('obs_type_max', ['rainRate']))
#set $recent = $span($day_delta=30, boundary='midnight')
#set $refresh = $to_int($DisplayOptions.get('refresh_interval', 60))

<!DOCTYPE html>
<html lang="$lang">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>$gettext("Statistics") &ndash; $station.location</title>
    <link rel="icon" href="favicon.ico" sizes="any">
    <link rel="stylesheet" href="horizon.css">
    #include "theme.inc"
    <script>
      (function () {
        try {
          var t = localStorage.getItem('weewx.horizon.theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    #include "analytics.inc"
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <div>
          <h1>$gettext("Statistics")</h1>
          <p class="updated"><a href="index.html">&larr; $station.location</a> &middot;
            <span class="visually-hidden">$gettext("Last update")</span>
            <span data-live="dateTime" data-raw="$current.dateTime.raw">$current.dateTime</span></p>
        </div>
      </header>

      <section class="panel" data-live-panel="stats">
        <div class="panel-head">
          <h2>$gettext("Statistical Summary")</h2>
        </div>
        <div class="panel-body flush">
          <div class="table-scroll">
            <table class="data-table stats">
              <thead>
                <tr>
                  <th scope="col">$gettext("Metric")</th>
#for $timespan in $timespans
                  <th scope="col">$gettext($timespan.capitalize())</th>
#end for
                </tr>
              </thead>
              <tbody>
#for $x in $observations
  #if $getattr($recent, $x, None) and $getattr($recent, $x).has_data
                <tr>
                  <th scope="row" class="metric">$obs.label[$x]</th>
    #for $timespan in $timespans
      #if $x in $obs_type_sum
                  <td class="num" data-label="$gettext($timespan.capitalize())">$getVar('%s.%s.sum' % ($timespan, $x)).format(add_label=False)</td>
      #elif $x in $obs_type_max
                  <td class="num stat-hi" data-label="$gettext($timespan.capitalize())">$getVar('%s.%s.max' % ($timespan, $x)).format(add_label=False)
                    <span class="when">$getVar('%s.%s.maxtime' % ($timespan, $x))</span></td>
      #else
                  <td class="num" data-label="$gettext($timespan.capitalize())">
                    <span class="stat-hi">$getVar('%s.%s.max' % ($timespan, $x)).format(add_label=False)</span> /
                    <span class="stat-lo">$getVar('%s.%s.min' % ($timespan, $x)).format(add_label=False)</span>
                    <span class="when">$getVar('%s.%s.maxtime' % ($timespan, $x))</span>
                  </td>
      #end if
    #end for
                </tr>
  #end if
#end for
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <p class="footer">
        $gettext("This station is controlled by <a href='https://weewx.com'>WeeWX</a>, an experimental weather software system written in Python.")
      </p>
    </div>

    #include "top.inc"

    <script>
      window.HORIZON = { refreshInterval: $refresh, generated: $current.dateTime.raw };
    </script>
    <script src="horizon.js"></script>
  </body>
</html>
