#errorCatcher Echo
#encoding UTF-8
##
## Kept deliberately small: it is fetched every refresh_interval seconds. Values are
## pre-formatted strings, so the client needs no unit or locale logic of its own.
##
#set $observations = $to_list($DisplayOptions.get('observations_current', ['outTemp', 'barometer']))
#set $fields = {}
#set $ignore = $fields.update({'dateTime': $str($current.dateTime), 'dateTime_raw': $current.dateTime.raw})
## How far apart this station's records are, in minutes. The page uses it to tell a
## slow archive interval from a station that has stopped sending. Two records' worth
## of silence is a fault. Without this the page would have to guess where that is,
## and a guess short enough to help a five-minute station would dim a slower one
## every cycle.
#if $current.interval.raw is not None
#set $ignore = $fields.update({'interval': $current.interval.raw})
#end if
#for $x in $observations
#if $getVar('year.%s.has_data' % $x, False)
#set $ignore = $fields.update({$x: $str($getVar('current.' + $x))})
#end if
#end for
## The colour of the headline follows the temperature, and the client works it out
## from degrees C so that it does not depend on what the page displays in.
#if $current.outTemp.degree_C.raw is not None
#set $ignore = $fields.update({'outTemp_c': $round($current.outTemp.degree_C.raw, 2)})
#end if
#set $ignore = $fields.update({'rainToday': $str($day.rain.sum)})
$jsonize($fields)
